#!gfx:interface\bfdi_decisions.gfx
guiTypes = {
	containerWindowType = {
		name = "bfdi_corp_trade_container"
		
		position = { x = 0 y = 0 }
		size = { width = 100% height = 570 }
		
		containerWindowType = {
			name = "corp_trade_list_container"
			position = { x = 5 y = 100 }
			size = { width = 500 height = 475 }
			verticalScrollbar = "right_vertical_slider"
			smooth_scrolling = yes
			
			background = {
				name = "bg"
				spriteType = "GFX_tiled_plain_bg"
			}

			gridboxtype = {
				name = "corp_trade_list_Entry_Flags"
				position = { x = 0 y = 2 }
				size = { width = 500 height = 345 }
				slotsize = { width = 500 height = 275 }
				max_slots_horizontal = 1
				add_horizontal = no
			}
		}
	}
	containerWindowType = {
		name = "corp_trade_list_Entry_Flags_Entry"
		size = { width = 50 height = 40 }
		position = { x = 0 y = 0 }

		iconType = {
			name = "corp_trade_list_Entry_Flags_Entry_Flag2"
			quadTextureSprite ="GFX_flag_small2"
			position = { x = 8 y = 13 }
			Orientation = "UPPER_LEFT"
		}
		iconType = { 
			name = "country_flag_frame"
			position = {x= 3 y = 10}
			spriteType = "GFX_small_flag_frame_thin2"
			alwaystransparent = yes
		}
	}
	containerWindowType = {
		name = "bfdi_corp_tradeDeal_container"
		
		position = { x = 0 y = 0 }
		size = { width = 475 height = 270 }

		background = {
			name="bg_YFC_corpTradeDeal_bg"
			quadTextureSprite = "GFX_tiled_window_thin_border2"
		}
		containerWindowType = {
			name = "bfdi_temp_container"
			size = { width = 500 height = 300 }
			position = { x = -5 y = 0 }
		
		buttonType = {
			name = "bfdi_corpTradeDeal_country_flag"
			quadTextureSprite ="GFX_player_flag"
			position = { x= 20 y = 17 }
			Orientation = "TOP_LEFT"
		}

		iconType = {
			name = "bfdi_corpTradeDeal_flag_frame"
			spriteType = "GFX_large_flag_frame"
			position = { x= 15 y = 15 }
			Orientation = "TOP_LEFT"
			alwaystransparent = yes
		}
		instantTextboxType = {
			name = "corp_trade_list_Entry_Flags_Entry_Info"
			position = { x = 130 y = 20 }
			font = "hoi_30header"
			text = [THIS.GetNameDefCap]
			maxWidth = 300
			format = left
			orientation = "TOP_LEFT"
			alwaystransparent = yes
		}

		buttonType = {
			name = "BuyingButton"
			position = { x = 20 y = 95 }
			quadTextureSprite ="GFX_icon_button_46x46"
			buttonText = "Buy" #UPDATE LATER
			buttonFont = "hoi_18mbs"
			clicksound = click_ok
			oversound = ui_menu_over
		}

		buttonType = {
			name = "SellingButton"
			position = { x = 20 y = 185 }
			quadTextureSprite ="GFX_icon_button_46x46"
			buttonText = "Sell" #UPDATE LATER
			buttonFont = "hoi_18mbs"
			clicksound = click_ok
			oversound = ui_menu_over
		}

		iconType = {
			name = "background_equipment_box_selling"
			spriteType = "GFX_YFC_trade_unselected"
			position = { x = 80 y = 80 }
		}	
		iconType = {
			name = "background_equipment_box_selling_item"
			position = { x = 150 y = 100 }
			alwaystransparent = yes
		}

		instantTextboxType = { 
			name = "selling_amount_text"
			text = [?THIS.selling_amount|Y0] 
			position = { x = 280 y = 130 }
			maxWidth = 100
			format = centre
			font = hoi_24header
		}

		iconType = {
			name = "background_equipment_box_buying"
			spriteType = "GFX_YFC_trade_unselected"
			position = { x = 80 y = 170 }
		}	
		iconType = {
			name = "background_equipment_box_buying_item"
			position = { x = 150 y = 190 }
			alwaystransparent = yes
		}

		instantTextboxType = { 
			name = "buying_amount_text"
			text = [?THIS.buying_amount|Y0]
			position = { x = 280 y = 220 }
			maxWidth = 100
			format = centre
			font = hoi_24header
		}

		instantTextboxType = { 
			name = "buying_cost_text"
			text = "$[?THIS.buying_cost^i|0]K([?ROOT.buying_X^i|1]x)"
			position = { x = 315 y = 95 }
			maxWidth = 200
			format = centre
			font = hoi_24header
		}

		buttonType = {
			name = "buying_item_button_increase_X"
			position = { x = 425 y = 125 }
			quadTextureSprite = "GFX_naval_increase_amount"
			pdx_tooltip = ""
			clicksound = click_default
		}

		buttonType = {
			name = "buying_item_button_decrease_X"
			position = { x = 385 y = 125 }
			quadTextureSprite = "GFX_naval_decrease_amount"
			pdx_tooltip = ""
			clicksound = click_default
		}

		instantTextboxType = { 
			name = "selling_cost_text"
			text = "$[?ROOT.selling_cost^i|0]K([?ROOT.selling_X^i|1]x)" 
			position = { x = 315 y = 185 }
			maxWidth = 200
			format = centre
			font = hoi_24header
		}

		buttonType = {
			name = "selling_item_button_increase_X"
			position = { x = 425 y = 215 }
			quadTextureSprite = "GFX_naval_increase_amount"
			pdx_tooltip = ""
			clicksound = click_default
		}

		buttonType = {
			name = "selling_item_button_decrease_X"
			position = { x = 385 y = 215 }
			quadTextureSprite = "GFX_naval_decrease_amount"
			pdx_tooltip = ""
			clicksound = click_default
		}

		}
	}
}